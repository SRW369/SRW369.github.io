rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      // Retain the current site's Google sign-in profile creation shape.
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'email', 'profileImage', 'createdAt',
          'savedAddresses', 'orderHistory'
        ]);
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'profileImage', 'savedAddresses']);
      allow delete: if false;

      match /orders/{orderId} {
        allow read: if owns(uid);
        // Verified orders must be written by trusted server code (Admin SDK).
        allow create, update, delete: if false;
      }
    }
  }
}
